{
  "name": "chinese-vault",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "description": "Aprende chino mandarín desde 0 — refugio post-apocalíptico estilo Pip-Boy. Pinyin primero, hanzi de propina, UI en español. HSK 0-1.",
  "license": "MIT",
  "author": "Antonio Galdó Seiquer",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && cross-env VITE_BASE_PATH=/chinese-vault/ vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "audio": "tsx scripts/generate-audio.ts",
    "audio:force": "tsx scripts/generate-audio.ts --force"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "msedge-tts": "^2.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
